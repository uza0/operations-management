# Claude transfer archives — never belong in the repo
*.tgz

# The Android wrapper's build output and its signing key. The key must be
# kept (an update signed with a different one installs as a different app)
# but it never belongs in the repository.
/apk/build/
/apk/keystore.jks
*.apk
/build-log.txt
*.idsig
/_to_delete/

# Files handed over by Claude, and what it could not delete itself
*.tar.gz
