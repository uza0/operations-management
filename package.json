{
  "name": "operations-management",
  "version": "1.0.0",
  "private": true,
  "description": "Operations Management — Event Team & Gate Operations Platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "node -e \"require('fs').mkdirSync('data',{recursive:true})\" && drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node -e \"require('fs').mkdirSync('data',{recursive:true})\" && tsx src/db/seed.ts",
    "db:seed:live": "node -e \"require('fs').mkdirSync('data',{recursive:true})\" && tsx src/db/seed-live-cli.ts",
    "db:reset": "node -e \"require('fs').rmSync('data/ops.db',{force:true})\" && npm run db:push -- --force && npm run db:seed",
    "db:reset:live": "node -e \"require('fs').rmSync('data/ops.db',{force:true})\" && npm run db:push -- --force && npm run db:seed:live",
    "setup": "npm run db:push -- --force && npm run db:seed",
    "db:embed": "drizzle-kit generate && node scripts/embed-schema.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "3.0.2",
    "dotenv": "^17.2.2",
    "drizzle-orm": "0.45.2",
    "jose": "6.1.0",
    "konva": "9.3.22",
    "next": "15.5.25",
    "qrcode": "1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-konva": "19.0.7",
    "web-push": "^3.6.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.18.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "10.4.21",
    "drizzle-kit": "0.31.4",
    "playwright": "^1.63.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
