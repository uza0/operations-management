# ---------------------------------------------------------------------------
# Operations Management — environment configuration
# Copy this file to `.env` and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# Database ------------------------------------------------------------------
# Default: zero-config local SQLite file (works out of the box, no account).
DATABASE_URL="file:./data/ops.db"

# Hosted database (Turso) — set these two and the app uses them instead.
# This is what the deployed site runs on. Free tier, no credit card.
#   TURSO_DATABASE_URL="libsql://your-db-name-you.turso.io"
#   TURSO_AUTH_TOKEN="ey..."
# See docs/DEPLOYMENT.md

# To move to PostgreSQL / Supabase instead:
#   1. change `dialect` in drizzle.config.ts from "sqlite" to "postgresql"
#   2. set DATABASE_URL to your connection string, e.g.
#      DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"
#   3. npx drizzle-kit generate && npx drizzle-kit migrate, then npm run db:seed
# See docs/POSTGRES_MIGRATION.md

# Session -------------------------------------------------------------------
# 32+ random characters. Generate with:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Seed accounts -------------------------------------------------------------
# Used only by `npm run db:seed`.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_LEADER_USERNAME="ahmed"
SEED_LEADER_PASSWORD="Leader@12345"
SEED_GATELEADER_PASSWORD="Gate@12345"

# First-run setup -----------------------------------------------------------
# Set this on a fresh deployment to enable GET /api/setup?key=... , which
# creates the tables and loads the demo data without a terminal. Leave it unset
# (the default) and that route does not exist. Unset it once you are done.
# SETUP_KEY=""

# App -----------------------------------------------------------------------
# Public base URL, used to build member links / QR codes.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEFAULT_LOCALE="ar"
